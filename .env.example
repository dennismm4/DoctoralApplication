# ---------------------------------------------------------------
# FRONTEND (build time). Values starting with VITE_ are PUBLIC —
# they are embedded in the JavaScript bundle. Never put secrets here.
# ---------------------------------------------------------------

# Optional: URL of your deployed drafting backend. Leave empty for demo mode.
VITE_API_BASE_URL=

# Optional remote account storage. These are public client settings, not secrets.
# Secure access depends on Supabase Auth + the row-level security policy in supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# ---------------------------------------------------------------
# BACKEND (server/index.mjs). Set these on your backend host only.
# Never commit real values.
# ---------------------------------------------------------------

# Optional: Gemini key — server-side only. Leave empty to run demo mode.
GEMINI_API_KEY=

# Required: the only origin allowed to call the backend (your Pages site).
ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io

# Optional; model choice is server-side. Current default: gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
PORT=8787
RATE_LIMIT_PER_HOUR=30
