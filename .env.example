# ---------------------------------------------------------------
# FRONTEND (build time). Values starting with VITE_ are PUBLIC —
# they are embedded in the JavaScript bundle. Never put secrets here.
# ---------------------------------------------------------------

# Optional: URL of your deployed drafting backend. Leave empty for demo mode.
VITE_API_BASE_URL=

# ---------------------------------------------------------------
# BACKEND (server/index.mjs). Set these on your server host only.
# Never commit real values.
# ---------------------------------------------------------------

# Required: AI provider key — server-side only.
ANTHROPIC_API_KEY=

# Required: the only origin allowed to call the backend (your Pages site).
ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io

# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
RATE_LIMIT_PER_HOUR=30
